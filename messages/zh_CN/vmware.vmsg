msg.cdrom.lockfail = "CD-ROM 正被其他处理进程读取，或已激活自动运行，或 CD-ROM 已在 Windows 文件总管中打开。这可能导致在虚拟机中读取 CD-ROM 时发生问题。请先停止读取 CD-ROM 的处理进程，再允许虚拟机读取。|0A若要立即运行，请选取 %1$s。若要稍后运行，请选取 %2$s，并在就绪时重新连接 CD-ROM。您亦可选取 %3$s 以略过此错误及日后所有类似错误。|0A"
msg.cdrom.notImplemented = "虚拟机发送了旧版仿真中未处理的 CD-ROM 命令。|0A命令封包为：%1$s|0A这不是严重错误，但可能导致尝试访问 CD-ROM 的应用程序发生错误。请尝试在不使用旧版仿真的情况下运行此虚拟机。"
msg.cdrom.notImplementedBug = "此错误已在内部记录为功能需求 %1$d。|0A"
