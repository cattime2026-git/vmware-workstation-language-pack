msg.hvuser.NoSVM = "此主机不支持 AMD-V 技术。"
msg.hvuser.NoVT = "此主机不支持 Intel VT-x 技术。"
msg.hvuser.SVMConfig = "此虚拟机组态不支持 AMD-V 作业。"
msg.hvuser.SVMDisabled = "此主机支持 AMD-V，但 AMD-V 已禁用。|0A若在 BIOS/固件设置中停用了 AMD-V，或变更此设置后未重新启动主机，则 AMD-V 可能已禁用。|0A(1) 确认 BIOS/固件设置允许 AMD-V。|0A(2) 若变更了此 BIOS/固件设置，请关闭再打开主机电源。|0A(3) 若自安装 %1$s 后未曾关闭再打开主机电源，请运行该操作。|0A(4) 以最新版本更新主机 BIOS/固件。"
msg.hvuser.SVMUnsupported = "此主机支持 AMD-V，但 AMD-V 实作与 %1$s 不兼容。"
msg.hvuser.VTConfig = "此虚拟机组态不支持 Intel VT-x 作业。"
msg.hvuser.VTDisabled = "此主机支持 Intel VT-x，但 Intel VT-x 已禁用。|0A若在 BIOS/固件设置中停用了 Intel VT-x，或变更此设置后未重新启动主机，则 Intel VT-x 可能已禁用。|0A(1) 确认 BIOS/固件设置允许 Intel VT-x 并停用「信任运行」。|0A(2) 若变更了任一 BIOS/固件设置，请关闭再打开主机电源。|0A(3) 若自安装 %1$s 后未曾关闭再打开主机电源，请运行该操作。|0A(4) 以最新版本更新主机 BIOS/固件。"
msg.hvuser.VTRestricted = "此主机支持 Intel VT-x，但 Intel VT-x 受限制。|0A若在 BIOS/固件设置中激活了「信任运行」，或变更此设置后未重新启动主机，则 Intel VT-x 可能受限制。|0A(1) 确认 BIOS/固件设置允许 Intel VT-x 并停用「信任运行」。|0A(2) 若变更了任一 BIOS/固件设置，请关闭再打开主机电源。|0A(3) 若自安装 %1$s 后未曾关闭再打开主机电源，请运行该操作。|0A(4) 以最新版本更新主机 BIOS/固件。"
msg.hvuser.VTUnlocked = "此主机支持 Intel VT-x，但 Intel VT-x 未锁定。|0A可能需要更新 BIOS/固件。|0A(1) 确认 BIOS/固件设置允许 Intel VT-x 并停用「信任运行」。|0A(2) 若变更了任一 BIOS/固件设置，请关闭再打开主机电源。|0A(3) 若自安装 %1$s 后未曾关闭再打开主机电源，请运行该操作。|0A(4) 以最新版本更新主机 BIOS/固件。"
