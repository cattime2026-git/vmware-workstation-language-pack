msg.guestos.backward = "在创建组态的 %1$s 软件版本中，客体操作系统设置仅为选用。在此版本中，为了性能及正确性，此设置为必要。|0A您的组态将 `hint.guestOS' 变量设为 `%2$s'。请确认此值反映运行的客体操作系统。|0A选取 %3$s 以升级组态档。您稍后需保存文件。|0A选取 %4$s 以不升级继续。|0A"
msg.guestos.badArch = "无法激活此虚拟机，因为它需要 %1$s 机器架构，与此 %2$s 机器架构主机不兼容。请参阅知识库文章 84273。|0A"
msg.guestos.badname = "不支持客体操作系统「%1$s」。|0A请在虚拟机设置的 %3$s 索引标签 %2$s 页面中选取其一。|0A"
msg.guestos.bootcamp = "您第一次搭配 %1$s 使用 Boot Camp 磁盘分割。|0A仅此一次，Microsoft Windows 将最多花费一分钟探索鼠标及其他虚拟硬件。|0A|0A在某些系统上，初始启动时可能侦测不到鼠标。若要激活鼠标，请停止并重新启动虚拟机。|0A|0A系统可能提示您重新激活 Windows。为达最佳结果，请在重新激活前安装 %2$s。|0A|0A若要安装 %3$s，请等候 Windows 启动，然后选择 %4$s > %5$s 并依照指示操作。|0A"
msg.guestos.noname = "组态档未指定客体操作系统。|0A请在虚拟机设置的 %2$s 索引标签下 %1$s 页面选取客体操作系统。|0A"
msg.gui.cannotReconnect = "无法连接至设备。%1$s 设置为此虚拟机的用户端设备。您必须手动重新连接。|0A"
msg.gui.cannotchangedir = "无法将目录变更为 %1$s：%2$s|0A"
msg.gui.noTools = "无 %1$s 套件可用。抱歉，此客体操作系统无 %2$s 套件可用。|0A"
msg.gui.noToolsForOther = "无 %1$s 套件可用。抱歉，客体操作系统「%3$s」无 %2$s 套件可用。请再次检查虚拟机设置，确认运行的客体操作系统在清单中。|0A"
msg.gui.toolsNoDevice = "此虚拟机未设置 %1$s 光驱。虚拟机必须设置 %2$s 光驱，此选项才能运作。|0A"
